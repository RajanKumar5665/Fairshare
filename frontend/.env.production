# Used by `npm run build` (production). Safe to commit: VITE_* values are public in the browser bundle.
# Empty VITE_API_URL = the API is on the same domain as the app (AWS EC2 + Nginx proxies /api to Node).
# If the API ever lives on another domain, put its full URL here, e.g. https://api.example.com
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=319795922398-1u3krc8e90ehq14m5sq5knt46bnogqtt.apps.googleusercontent.com
