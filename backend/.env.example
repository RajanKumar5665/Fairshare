# Copy to backend/.env for local development.
# On Render, set the same keys in Dashboard → Environment (the .env file is NOT deployed).
#
#                         LOCAL (backend/.env)                 PRODUCTION (Render dashboard)
# NODE_ENV                development                          production
# CLIENT_URL              http://localhost:5173                https://fairshare-blue.vercel.app
# TRUSTED_ORIGINS         (leave empty)                        https://fairshare-blue.vercel.app,https://fairshareblue.vercel.app
# COOKIE_DOMAIN           localhost                            (leave EMPTY – frontend and API are on different domains)
# MONGO_URI               mongodb://localhost:27017/hisabhub   your MongoDB Atlas connection string
# RAZORPAY_MODE           test                                 live (with live keys) or test
# PORT                    4000                                 (Render sets this itself – don't add it)

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
TRUSTED_ORIGINS=
COOKIE_DOMAIN=localhost

MONGO_URI=mongodb://localhost:27017/hisabhub

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_NUMBER=
TWILIO_WHATSAPP_NUMBER=
OTP_EXPIRY_MINUTES=5

RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

ADMIN_REGISTRATION_SECRET=
